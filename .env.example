NODE_ENV=production
APP_ORIGIN=https://atlas.example.com

# Prefer separate fields so special characters in the password do not need URL encoding.
DB_HOST=pgm-example.pg.cnhk.rds.aliyuncs.com
DB_PORT=5432
DB_NAME=atlas
DB_USER=atlas_app
DB_PASSWORD=replace-with-a-new-secret
DB_SSL=false

OSS_REGION=oss-cn-hongkong
OSS_BUCKET=replace-with-your-private-bucket
# Recommended on ECS: attach a RAM role and set its role name here.
ALIBABA_CLOUD_ECS_ROLE_NAME=atlas-ecs-role
# Local fallback only: use a limited RAM user, never the root account AccessKey.
# ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-ram-user-access-key-id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-ram-user-access-key-secret
# ALIBABA_CLOUD_SECURITY_TOKEN=only-needed-for-temporary-sts-credentials
